  "efemerides": [
    {
      "title": "Día Internacional de la Lengua Materna",
      "m": 1,
      "d": 21,
      "cat": "Novela y ficción",
      "text": "Proclamado por la UNESCO para promover la diversidad lingüística y el multilingüismo. En la biblioteca: lecturas en distintos idiomas y mesa de literatura en lenguas originarias."
    },
    {
      "title": "Día Mundial de la Poesía",
      "m": 2,
      "d": 21,
      "cat": "Novela y ficción",
      "text": "Desde 1999, la UNESCO dedica este día a la palabra poética. En la biblioteca: micrófono abierto, lecturas en voz alta y recitales para todas las edades."
    },
    {
      "title": "Día Internacional del Libro Infantil",
      "m": 3,
      "d": 2,
      "cat": "Infantil y juvenil",
      "text": "Se celebra desde 1967 en el natalicio de Hans Christian Andersen. En la biblioteca: cuentacuentos, talleres de ilustración y préstamos especiales para los más chicos."
    },
    {
      "title": "Día Mundial del Libro y del Derecho de Autor",
      "m": 3,
      "d": 23,
      "cat": "Novela y ficción",
      "text": "La UNESCO eligió esta fecha por Cervantes, Shakespeare y el Inca Garcilaso de la Vega, fallecidos en 1616. En la biblioteca: feria de intercambio de libros y charlas con autores."
    },
    {
      "title": "Día Internacional de la Alfabetización",
      "m": 8,
      "d": 8,
      "cat": "Historia y sociedad",
      "text": "Proclamado por la UNESCO para recordar que leer y escribir son derechos humanos. En la biblioteca: tutorías gratuitas y jornadas de lectura compartida."
    }
  ],
